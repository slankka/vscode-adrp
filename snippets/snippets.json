{
  "提案元信息表": {
    "prefix": "adrp-meta",
    "body": [
      "| 属性 | 内容 |",
      "|---|---|",
      "| 状态 | ${1|Draft,Ready,Implemented,Archived|} |",
      "| 负责人 | ${2:待分配} |",
      "| 创建 / 更新日期 | ${3:${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}} |",
      "| 关联提案 | ${4:-} |",
      "| 当前交付目标 | ${5:-} |"
    ],
    "description": "提案元信息表（状态 / 负责人 / 更新日期 / 关联提案）"
  },
  "提案事实与证据章节": {
    "prefix": "adrp-evidence",
    "body": [
      "## 2. 事实与证据",
      "",
      "依据 [${1:文档或提案}](${2:链接}) 及 ${3:验证方式}：",
      "",
      "- ${4:结论一}",
      "- ${5:结论二}"
    ],
    "description": "事实与证据章节，供 Ready 状态提案引用"
  },
  "提案骨架": {
    "prefix": "adrp-skeleton",
    "body": [
      "# ${1:DBIP}-${2:000} ${3:标题}",
      "",
      "| 属性 | 内容 |",
      "|---|---|",
      "| 状态 | Draft |",
      "| 负责人 | ${4:待分配} |",
      "| 创建 / 更新日期 | ${5:${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}} |",
      "| 关联提案 | ${6:-} |",
      "",
      "## 1. 背景与目标",
      "",
      "${7:待补充}",
      "",
      "## 2. 事实与证据",
      "",
      "依据 ${8:文档 / 验证方式}：",
      "",
      "- ${9:待补充}",
      "",
      "## 3. 范围与非目标",
      "",
      "${10:待补充}",
      "",
      "## 4. 方案",
      "",
      "${11:待补充}",
      "",
      "## 5. 验证与欠缺",
      "",
      "${12:待补充}"
    ],
    "description": "完整提案骨架（标题 + 元信息表 + 五节正文）"
  }
}
